# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Service ──────────────────────────────────────────────────────────────────
NOTIFICATION_SERVICE_PORT=9004

# ─── JWT Public Key (for verifying hospital tokens) ───────────────────────────
JWT_PUBLIC_KEY_PATH=../auth-service/keys/auth_public.pem

# ─── SMS Provider ─────────────────────────────────────────────────────────────
# Options: 'mock' (prints to stdout) or 'msg91' (production)
SMS_PROVIDER=mock
MSG91_AUTH_KEY=mock
MSG91_TEMPLATE_ID=mock
