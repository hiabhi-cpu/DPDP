# emergency-service configuration — copy to .env and fill in.
EMERGENCY_SERVICE_PORT=9005
# Runtime role — least-privilege dpdp_app (NOT the admin/superuser).
DATABASE_URL=postgres://dpdp_app:dpdp_app_local_dev_pw@localhost:5432/dpdp?sslmode=disable
# RS256 public key (verifies hospital JWTs + is used by audit-service for service tokens).
JWT_PUBLIC_KEY_PATH=../auth-service/keys/auth_public.pem
# Internal services.
AUTH_SERVICE_URL=http://localhost:9006
AUDIT_SERVICE_URL=http://localhost:9001
# Bootstrap secret for minting internal service tokens — MUST match auth-service.
SERVICE_TOKEN_SECRET=LOCAL-INTERNAL-SERVICE-SECRET-DEV-ONLY
# Secrets provider (mock locally; AWS Secrets Manager in prod).
AWS_SECRETS_MOCK=true
LOCAL_SECRETS_PATH=../DPDP/secrets/local_hospital_keys.json
