# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=dpdp
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/dpdp?sslmode=disable

# ─── Service ──────────────────────────────────────────────────────────────────
CONSENT_SERVICE_PORT=9000

# ─── JWT Public Key (for verifying hospital tokens) ───────────────────────────
JWT_PUBLIC_KEY_PATH=../auth-service/keys/auth_public.pem

# ─── Dependency Services ──────────────────────────────────────────────────────
AUDIT_SERVICE_URL=http://localhost:9001
NOTIFICATION_SERVICE_URL=http://localhost:9004

# ─── Secrets ──────────────────────────────────────────────────────────────────
AWS_SECRETS_MOCK=true
LOCAL_SECRETS_PATH=../DPDP/secrets/local_hospital_keys.json
