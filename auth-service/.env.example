# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=dpdp
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/dpdp?sslmode=disable

# ─── Service ──────────────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=9006

# ─── RSA Keys (run `make gen-keys` to generate) ───────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/auth_private.pem
JWT_PUBLIC_KEY_PATH=./keys/auth_public.pem
JWT_EXPIRY_HOURS=24
